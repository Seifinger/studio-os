{
  "name": "studio-os",
  "version": "0.1.0",
  "private": true,
  "description": "Grundlage eines KI-unterstützten Website-Studios für lokale Betriebe.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "export:showcases": "node scripts/export-showcases.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:export": "vitest run --config vitest.export.config.mts",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/antonio": "5.3.0",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/chivo": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/figtree": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/karla": "5.3.0",
    "@fontsource/libre-caslon-display": "5.3.0",
    "@fontsource/libre-franklin": "5.3.0",
    "@fontsource/marcellus": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/reem-kufi": "5.3.0",
    "@fontsource/rozha-one": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "@fontsource/vollkorn": "5.3.0",
    "@fontsource/work-sans": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
