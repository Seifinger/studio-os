# studio-os – Umgebungsvariablen
#
# Kopieren nach .env.local (git-ignoriert) und nur die Werte setzen, die gebraucht werden.
# In der Foundation ist KEINE Variable Pflicht. Alle Integrationen sind ohne Wert abgeschaltet.
# Geheimnisse nie mit NEXT_PUBLIC_ beginnen lassen – sie landen sonst im Browser.
# Beschreibung und Validierung: src/server/env.ts · Übersicht: ARCHITECTURE.md, Abschnitt 6

# Google Places API (New) – Lead-Demos (Stufe 4, nur lokal) und Lead-Recherche (Stufe 8), nur serverseitig
GOOGLE_PLACES_API_KEY=

# Supabase – Datenbank/Auth (ab Stufe 7). URL und Service-Role-Key nur gemeinsam.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend – Anfragen per E-Mail (ab Stufe 5). Schlüssel und Absender nur gemeinsam.
# EMAIL_FROM muss eine bei Resend verifizierte Domain nutzen, z. B. "Anfragen <anfragen@studio.example>".
RESEND_API_KEY=
EMAIL_FROM=
# Nur für Tests oder einen eigenen Proxy; leer = https://api.resend.com. http nur für localhost.
RESEND_BASE_URL=

# Vercel-API – automatisierte Deployments (später; Hosting selbst braucht keinen Schlüssel)
VERCEL_TOKEN=

# KI-Anbieter – Textvorschläge (optional)
ANTHROPIC_API_KEY=

# Lead-Demos (/demo): "local" schaltet sie ein – nur erreichbar über localhost, nie öffentlich.
# Braucht zusätzlich GOOGLE_PLACES_API_KEY. Leer oder "off" = abgeschaltet.
STUDIO_LEAD_DEMOS=

# Anfrage-Probe (/anfrage-probe): "local" schaltet sie ein – nur über localhost. Verschickt echte
# E-Mails mit einem erfundenen Beispielhaus an STUDIO_OPERATOR_EMAIL und an die eingetragene Gast-Adresse.
# Braucht RESEND_API_KEY, EMAIL_FROM und STUDIO_OPERATOR_*. Leer oder "off" = abgeschaltet.
STUDIO_REQUEST_PROBE=

# Anbieterkennzeichnung der öffentlichen Beispielseiten (Impressum, Datenschutz). Nur gemeinsam.
# Ohne diese Angaben lässt sich der statische Export nicht veröffentlichen (npm run check:export).
STUDIO_OPERATOR_NAME=
STUDIO_OPERATOR_ADDRESS=
STUDIO_OPERATOR_EMAIL=
